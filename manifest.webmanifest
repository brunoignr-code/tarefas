{
  "name": "Tarefas",
  "short_name": "Tarefas",
  "description": "Gerenciador pessoal de tarefas que funciona offline.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EAF2F5",
  "theme_color": "#EAF2F5",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "share-title", "text": "share-text", "url": "share-url" }
  },
  "shortcuts": [
    { "name": "Nova tarefa", "short_name": "Nova", "url": "./?novo=1#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Próximos dias", "short_name": "Próximos", "url": "./#upcoming", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
